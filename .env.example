# Quick-start defaults. DEMO_MODE must be false in a real deployment.
DEMO_MODE=true
ENVIRONMENT=local
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./local.db
UPLOAD_ROOT=uploads/materials
MAX_UPLOAD_BYTES=12582912
KNOWLEDGE_BASE_DIR=examples/knowledge_base
WORKFLOW_CONFIG_PATH=examples/workflows/default.yaml
LOG_LEVEL=INFO

# Required outside demo mode. Generate a random 32+ character secret and a strong password.
APP_SESSION_SECRET=
HR_ADMIN_USERNAME=admin
HR_ADMIN_PASSWORD=
CANDIDATE_TOKEN_TTL_SECONDS=2592000

# Privacy and outbound AI are opt-in.
STORE_EVENT_PAYLOADS=false
STORE_RAW_OCR_TEXT=false
ALLOW_EXTERNAL_AI=false
ALLOW_PRIVATE_PROVIDER_URLS=false

# Provider selection.
LLM_PROVIDER=mock
OCR_PROVIDER=mock
QA_LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=none

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLE_GOOGLE_SEARCH=false
GEMINI_PROXY_URL=
GEMINI_TIMEOUT_SECONDS=120
GEMINI_GATEWAY_URL=
GEMINI_GATEWAY_TOKEN=
GEMINI_GATEWAY_TIMEOUT_SECONDS=120

ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-lite-260428
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=120

ZHIPU_API_KEY=
ZHIPU_TEXT_MODEL=glm-4.5-air
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TIMEOUT_SECONDS=120

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30

# Feishu/Lark integration. Leave empty for demo mode.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_MAX_EVENT_AGE_SECONDS=300
FEISHU_BOT_APP_NAME=HR Onboarding Agent
FEISHU_BASE_APP_TOKEN=
FEISHU_CANDIDATE_TABLE_ID=
FEISHU_NODE_TABLE_ID=
FEISHU_MATERIAL_TABLE_ID=
FEISHU_FAQ_TABLE_ID=
FEISHU_WEB_APP_BASE_URL=
FEISHU_HR_DASHBOARD_URL=
